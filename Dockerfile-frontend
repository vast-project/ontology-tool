FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build-env
WORKDIR /

# Copy everything
COPY . ./

#install node
RUN curl -sL https://deb.nodesource.com/setup_24.x |  bash -
RUN apt-get install -y nodejs


WORKDIR /frontend/ontology
# Restore as distinct layers
RUN dotnet restore
# Build and publish a release
RUN dotnet publish -c Release -o publishContainer

# Build runtime image
FROM mcr.microsoft.com/dotnet/aspnet:10.0
# .NET 8+ base images default to ASPNETCORE_HTTP_PORTS=8080, whereas the aspnet:7.0
# image these replaced set ASPNETCORE_URLS=http://+:80. Pin it back to 80 so existing
# port mappings and compose/k8s configs keep working unchanged.
ENV ASPNETCORE_HTTP_PORTS=80
RUN apt-get update && apt-get -y upgrade
WORKDIR /frontend/ontology
COPY --from=build-env /frontend/ontology/publishContainer .
ENTRYPOINT ["dotnet", "ontology.dll"]